# Supabase Configuration
# URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon API key from Supabase Dashboard -> Project Settings -> API
# IMPORTANT: Use the 'anon' (public) key here!
# DO NOT use the 'service_role' key or secret API keys (sbp_...) as they will be blocked by Supabase in browser environments.
VITE_SUPABASE_ANON_KEY=your-actual-anon-public-key
